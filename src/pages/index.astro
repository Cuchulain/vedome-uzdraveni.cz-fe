---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import logoTransparent from '../assets/logo-transparent.png';
import profilePhoto from '../assets/profilovka-ctverec.png';

const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order
);
const visibleTestimonials = testimonials.slice(0, 3);
const remainingTestimonials = testimonials.slice(3);

const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3001';
const apiKey = import.meta.env.PUBLIC_API_KEY ?? '';
---

<BaseLayout
  title="Magie Vědomého Uzdravení – e-book"
  description="Osobní zkušenost Jana Čejky a praktický 21denní postup pro vědomou práci s tělem, energií, záměrem a vizualizací."
>
  <!-- Hero sales section -->
  <section class="bg-gradient-to-b from-primary-dark to-primary text-white py-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-accent/80 text-sm uppercase tracking-widest mb-4">E-book</p>
      <h1 class="text-4xl sm:text-5xl font-serif font-bold mb-6 leading-tight">
        Magie Vědomého Uzdravení
      </h1>
      <p class="text-xl text-accent/90 mb-8">
        Osobní zkušenost a praktický 21denní postup pro vědomou práci s tělem, energií,
        záměrem a vizualizací.
      </p>
      <a
        href="#koupit"
        class="bg-white text-primary-dark font-bold px-10 py-4 rounded-xl hover:bg-accent transition-colors text-lg inline-block"
      >
        Chci e-book →
      </a>
      <p class="mt-3">
        <a
          href="/mira"
          class="inline-flex min-h-11 items-center px-2 text-accent/90 font-medium underline underline-offset-4 hover:text-white transition-colors"
        >
          Zjistit, jak funguje Mira →
        </a>
      </p>
    </div>
  </section>

  <!-- Příběh -->
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-serif font-bold text-primary-dark mb-6">Můj příběh</h2>
    <div class="flex flex-col sm:flex-row gap-8 items-center sm:items-start">
      <div class="space-y-4 text-text flex-1">
        <p>
          Bylo mi čtyřicet, když mě v noci vzbudila silná bolest palce u nohy. Záněty se
          vracely stále častěji – jednou palec, jindy kotník. Podle příznaků šlo o
          <strong>dnu</strong> a všude jsem četl, že mě čeká celoživotní dieta a léčba.
        </p>
        <p>
          Asi půl roku jsem tomu věřil. Pak jsem se rozhodl využít více než 25 let studia
          vědomých léčivých procesů a pracovat se svým tělem každý den – vědomě a metodicky.
        </p>
        <p>
          U mě se záchvaty přestaly vracet a stav kloubů se zlepšil. Svou osobní zkušenost
          a postup jsem sepsal do e-booku pro každého, koho tento způsob práce se sebou
          oslovuje.
        </p>
      </div>
      <div class="shrink-0 sm:mt-1 flex flex-col items-center">
        <Image
          src={profilePhoto}
          alt="Jan Čejka"
          width={160}
          height={160}
          densities={[1, 2, 3]}
          class="w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover shadow-md border-2 border-accent"
        />
        <p class="text-center text-sm text-muted mt-2 font-medium">Jan Čejka</p>
      </div>
    </div>
  </section>

  <!-- Co je v e-booku -->
  <section class="bg-accent/20 py-16 px-4">
    <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-center gap-10">
      <div class="flex-1">
        <h2 class="text-2xl font-serif font-bold text-primary-dark mb-8">Co e-book obsahuje</h2>
        <ul class="space-y-4">
          {[
            '21denní postup, který Jan vytvořil na základě vlastní zkušenosti',
            'Cvičení pro vědomou komunikaci s tělem a podporu každodenní péče',
            'Meditace a techniky, které zvládnete i bez předchozí zkušenosti',
            'Jak v jednotlivých krocích pracovat s energií, záměrem a vizualizací',
            'Jak si pravidelnou praxi udržet dlouhodobě',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold text-lg mt-0.5">✓</span>
              <span class="text-text">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="shrink-0 pointer-events-none" aria-hidden="true">
        <Image
          src={logoTransparent}
          alt=""
          width={220}
          height={220}
          densities={[1, 2, 3]}
          class="w-44 h-44 sm:w-56 sm:h-56 opacity-40 drop-shadow-md"
        />
      </div>
    </div>
  </section>

  <!-- Mira -->
  <section class="max-w-3xl mx-auto px-4 py-16">
    <div class="bg-white rounded-2xl shadow-sm border border-accent/40 p-8 sm:p-10 text-center">
      <p class="text-sm text-primary uppercase tracking-widest mb-3">
        Mira · průvodkyně uzdravením
      </p>
      <h2 class="text-2xl font-serif font-bold text-primary-dark mb-4">
        Chcete si o vědomém uzdravení popovídat?
      </h2>
      <p class="text-text leading-relaxed max-w-2xl mx-auto mb-3">
        Mira zná obsah knihy Magie Vědomého Uzdravení. Můžete se jí ptát na 21denní postup,
        komunikaci s tělem, meditaci Strom života i práci s energií, záměrem a
        vizualizací.
      </p>
      <p class="mb-7">
        <a
          href="/mira"
          class="inline-flex min-h-11 items-center px-2 text-primary font-semibold underline underline-offset-4 hover:text-primary-light transition-colors"
        >
          Zjistit více o Miře →
        </a>
      </p>
      <a
        href="https://t.me/uSkyCzBot?start=UZDRA20"
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="chatbot-open"
        data-umami-event-bot="vedome-uzdraveni"
        data-umami-event-placement="homepage-guide-section"
        class="bg-primary text-white font-bold px-8 py-4 rounded-xl hover:bg-primary-light transition-colors text-lg inline-block"
      >
        Promluvit si s Mirou v Telegramu →
      </a>
      <p class="text-sm text-muted mt-4">
        Prvních 20 zpráv máte zdarma. Další zprávy si můžete kdykoli dokoupit.
      </p>
    </div>
  </section>

  <!-- Reference -->
  {testimonials.length > 0 && (
    <section class="max-w-4xl mx-auto px-4 py-16">
      <h2 class="text-2xl font-serif font-bold text-primary-dark mb-10 text-center">Co říkají čtenáři</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        {visibleTestimonials.map((testimonial) => <TestimonialCard testimonial={testimonial} />)}
      </div>
      {remainingTestimonials.length > 0 && (
        <details class="group mt-8">
          <summary class="mx-auto flex min-h-11 w-fit cursor-pointer list-none items-center rounded-lg px-4 text-sm font-semibold text-primary hover:bg-primary/5">
            <span class="group-open:hidden">Zobrazit další reference ↓</span>
            <span class="hidden group-open:inline">Skrýt další reference ↑</span>
          </summary>
          <div class="mt-6 grid gap-6 sm:grid-cols-2">
            {remainingTestimonials.map((testimonial) => (
              <TestimonialCard testimonial={testimonial} />
            ))}
          </div>
        </details>
      )}
    </section>
  )}

  <!-- Druhá CTA za referencemi -->
  <section class="bg-primary/5 border-y border-primary/10 py-12 px-4 text-center">
    <div class="max-w-xl mx-auto">
      <p class="text-primary-dark font-serif text-xl font-bold mb-2">
        Chcete vyzkoušet 21denní postup?
      </p>
      <p class="text-muted text-sm mb-6">
        E-book si stáhnete ihned po zaplacení a můžete začít vlastním tempem.
      </p>
      <a
        href="#koupit"
        class="bg-primary text-white font-bold px-10 py-4 rounded-xl hover:bg-primary-light transition-colors text-lg inline-block"
      >
        Získat e-book →
      </a>
    </div>
  </section>

  <!-- CTA / nákup -->
  <section id="koupit" class="max-w-xl mx-auto px-4 py-16 text-center">
    <div class="bg-white rounded-2xl shadow-lg border border-accent/40 p-10">
      <p class="text-sm text-muted uppercase tracking-widest mb-2">E-book ke stažení</p>
      <h2 class="text-2xl font-serif font-bold text-primary-dark mb-2">Magie Vědomého Uzdravení</h2>
      <p class="text-4xl font-bold text-primary my-6">497 Kč</p>
      <ul class="text-sm text-muted space-y-1 mb-8">
        <li>✓ Okamžité stažení ve formátu PDF</li>
        <li>✓ Přístup do členské sekce s bonusy</li>
        <li>✓ Platba kartou, Apple Pay nebo Google Pay</li>
      </ul>
      <button
        id="buy-btn"
        class="w-full bg-primary text-white font-bold py-4 rounded-xl hover:bg-primary-light transition-colors text-lg"
      >
        Koupit e-book
      </button>
      <p id="buy-error" class="text-red-600 text-sm mt-3 hidden"></p>
      <p class="text-xs text-muted mt-4">Bezpečná platba přes Stripe. Faktura přijde e-mailem.</p>
      <p class="text-xs text-muted mt-3">
        🛡️ <strong>30denní garance vrácení peněz.</strong> Pokud nebudete spokojeni, vrátíme vám celou částku bez otázek. Více v <a href="/obchodni-podminky" class="underline hover:text-primary">obchodních podmínkách</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ apiUrl, apiKey }}>
  document.getElementById('buy-btn').addEventListener('click', async () => {
    const btn = document.getElementById('buy-btn');
    const err = document.getElementById('buy-error');
    btn.disabled = true;
    btn.textContent = 'Přesměrovávám na platbu…';

    try {
      const res = await fetch(`${apiUrl}/api/stripe/checkout`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-API-Key': apiKey },
        body: JSON.stringify({}),
      });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
      } else {
        throw new Error('Chybí URL');
      }
    } catch {
      err.textContent = 'Nepodařilo se zahájit platbu. Zkuste to prosím znovu.';
      err.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Koupit e-book';
    }
  });
</script>
