---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="max-w-3xl mx-auto px-4 py-16">
    <header class="mb-10">
      <time class="text-xs text-muted">
        {post.data.pubDate.toLocaleDateString('cs-CZ', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-primary-dark mt-2">
        {post.data.title}
      </h1>
    </header>

    <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-primary-dark prose-a:text-primary prose-strong:text-text">
      <Content />
    </div>

    <footer class="mt-16 pt-8 border-t border-accent">
      <a href="/novinky" class="text-primary font-medium hover:underline text-sm">← Zpět na seznam článků</a>
    </footer>
  </article>
</BaseLayout>
