---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
}

const { testimonial } = Astro.props;
const { Content } = await render(testimonial);
const { author, excerpt, location } = testimonial.data;
---

<article class="bg-white rounded-xl p-6 shadow-sm border border-accent/40 flex flex-col">
  {
    excerpt ? (
      <details class="group flex-1">
        <summary class="list-none cursor-pointer rounded-sm">
          <p class="text-text italic text-sm leading-relaxed mb-3">{excerpt}</p>
          <span class="inline-flex min-h-11 items-center gap-1 text-primary text-xs font-medium group-open:hidden">
            Celé hodnocení
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
              class="w-3 h-3"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"
                clip-rule="evenodd"
              />
            </svg>
          </span>
          <span class="hidden min-h-11 group-open:inline-flex items-center gap-1 text-muted text-xs font-medium">
            Skrýt
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
              class="w-3 h-3"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M11.78 9.78a.75.75 0 0 1-1.06 0L8 7.06 5.28 9.78a.75.75 0 0 1-1.06-1.06l3.25-3.25a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06Z"
                clip-rule="evenodd"
              />
            </svg>
          </span>
        </summary>
        <div class="mt-3 pt-3 border-t border-accent/30 text-text italic text-sm leading-relaxed prose prose-sm max-w-none">
          <Content />
        </div>
      </details>
    ) : (
      <div class="text-text italic text-sm leading-relaxed prose prose-sm max-w-none flex-1">
        <Content />
      </div>
    )
  }
  <footer class="mt-4 pt-3 border-t border-accent/20">
    <p class="text-sm font-semibold text-primary-dark">{author}</p>
    {location && <p class="text-xs text-muted">{location}</p>}
  </footer>
</article>
